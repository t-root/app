<?xml version="1.0" encoding="utf-8"?>
<!-- NEXORA's cover block: leaves other apps' floating windows uncovered. Reads
     the window list (type, bounds, owning package) to know where they are —
     never any text or content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/cover_accessibility_description"
    android:notificationTimeout="50" />
